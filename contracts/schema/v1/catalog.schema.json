{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2-prism.local/contracts/schema/v1/catalog.schema.json",
  "title": "H2-PRISM Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "build_utc",
    "source_repository_commit",
    "data_release_checksum",
    "label_set",
    "supported_features",
    "scenarios",
    "metrics_catalog"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "release_id": { "type": "string", "minLength": 1 },
    "build_utc": { "type": "string", "format": "date-time" },
    "source_repository_commit": { "type": "string", "minLength": 7 },
    "data_release_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "label_set": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "supported_features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localization",
        "inference",
        "baseline_comparison",
        "gas_comparison",
        "operating_condition_analysis"
      ],
      "properties": {
        "localization": { "type": "boolean" },
        "inference": { "type": "boolean" },
        "baseline_comparison": { "type": "boolean" },
        "gas_comparison": { "type": "boolean" },
        "operating_condition_analysis": { "type": "boolean" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "family_id",
          "scenario_class",
          "summary_hint",
          "data_path",
          "sha256",
          "gas_metadata_status",
          "topology_id",
          "provenance_status",
          "split",
          "time_range",
          "samples",
          "publish_approved"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "family_id": { "type": "string", "minLength": 1 },
          "scenario_class": { "type": "string", "minLength": 1 },
          "summary_hint": { "type": "string", "minLength": 1 },
          "data_path": { "type": "string", "pattern": "^data/scenarios/[a-zA-Z0-9._-]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "gas_metadata_status": { "type": "string" },
          "topology_id": { "type": "string", "minLength": 1 },
          "provenance_status": {
            "type": "string",
            "enum": ["VERIFIED_EXPORT", "FIXTURE_ONLY"]
          },
          "split": { "type": "string", "enum": ["train", "dev", "test", "fixture"] },
          "time_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          },
          "samples": { "type": "integer", "minimum": 2 },
          "publish_approved": { "type": "boolean" }
        }
      }
    },
    "metrics_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "data_path", "sha256"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "data_path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
