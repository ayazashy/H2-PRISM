{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2-prism.local/contracts/schema/v1/scenario.schema.json",
  "title": "H2-PRISM Scenario Replay v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "provenance_status",
    "topology_id",
    "time_seconds",
    "sensor_channels",
    "event",
    "model_result",
    "location_prediction"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "provenance_status": { "type": "string", "enum": ["VERIFIED_EXPORT", "FIXTURE_ONLY"] },
    "topology_id": { "type": "string", "minLength": 1 },
    "time_seconds": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "number" }
    },
    "sensor_channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "node_or_edge", "variable", "unit", "pressure_reference", "values", "observable"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "node_or_edge": { "type": "string", "minLength": 1 },
          "variable": { "type": "string", "enum": ["pressure", "mass_flow"] },
          "unit": { "type": "string", "minLength": 1 },
          "pressure_reference": { "type": ["string", "null"], "enum": ["absolute", "gauge", null] },
          "values": {
            "type": "array",
            "items": { "type": ["number", "null"] }
          },
          "observable": { "type": "boolean" }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ground_truth_class", "onset_time", "end_time", "true_edges_or_nodes", "label_status"],
      "properties": {
        "ground_truth_class": { "type": "string", "minLength": 1 },
        "onset_time": { "type": ["number", "null"] },
        "end_time": { "type": ["number", "null"] },
        "true_edges_or_nodes": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "label_status": { "type": "string", "minLength": 1 }
      }
    },
    "model_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "artifact_hash",
        "model_version",
        "predicted_class",
        "decision",
        "reason_code",
        "reason_summary",
        "score",
        "score_definition",
        "timestamp_scope"
      ],
      "properties": {
        "experiment_id": { "type": "string", "minLength": 1 },
        "artifact_hash": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "predicted_class": { "type": ["string", "null"] },
        "decision": { "type": "string", "enum": ["SPECIFIC", "AMBIGUOUS", "UNRESOLVED"] },
        "reason_code": { "type": "string", "minLength": 1 },
        "reason_summary": { "type": "string", "minLength": 1 },
        "score": { "type": ["number", "null"] },
        "score_definition": { "type": ["string", "null"] },
        "timestamp_scope": { "type": "string", "minLength": 1 }
      }
    },
    "location_prediction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["predicted_edge_or_node", "metric_name", "error_value", "error_unit"],
      "properties": {
        "predicted_edge_or_node": { "type": "string", "minLength": 1 },
        "metric_name": { "type": "string", "minLength": 1 },
        "error_value": { "type": ["number", "null"] },
        "error_unit": { "type": ["string", "null"] }
      }
    }
  }
}
