{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2-prism.local/contracts/schema/v1/topology.schema.json",
  "title": "H2-PRISM Topology v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topology_id", "is_schematic", "coordinate_note", "nodes", "edges", "sensors"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "topology_id": { "type": "string", "minLength": 1 },
    "is_schematic": { "type": "boolean" },
    "coordinate_note": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "x", "y", "z"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["source", "junction", "compressor", "delivery"] },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "source", "target", "component_group"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "component_group": { "type": "string" }
        }
      }
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "attached_to", "variable"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "attached_to": { "type": "string", "minLength": 1 },
          "variable": { "type": "string", "enum": ["pressure", "mass_flow"] }
        }
      }
    }
  }
}
